# Coolify API base, as seen from inside the container.
# Same host:  http://host.docker.internal:8000
# coolify network: http://coolify:8000
# Do not rename to COOLIFY_URL: Coolify reserves that name for the app's own URL.
COOLIFY_API_URL=http://host.docker.internal:8000

# API token with the "deploy" ability. Leave empty for a read-only dashboard.
COOLIFY_TOKEN=

# Optional
# DOCKER_SOCK=/var/run/docker.sock

# Or talk to a socket proxy instead of the daemon (overrides DOCKER_SOCK)
# DOCKER_URL=http://docker-proxy:2375
# UPDATES_PORT=8799
# UPDATES_BIND=0.0.0.0
# UPDATES_STATE=/data/state.json
# UPDATES_WORKERS=8
# UPDATES_IGNORE=^coolify(-|$)
# UPDATES_TIMEOUT=60
# UPDATES_TAGS_TTL=21600
# UPDATES_DIGEST_TTL=900
# UPDATES_PREVIEW_TTL=300
# UPDATES_VERSIONS_TTL=300

# Coolify UI base for the "open in Coolify" links in the progress dialog
# COOLIFY_UI_URL=https://coolify.example.com
